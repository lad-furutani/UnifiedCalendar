<Project>
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained Condition="'$(Configuration)' == 'Release' and '$(MSBuildProjectName)' == 'UnifiedCalendar.App'">true</SelfContained>
    <SelfContained Condition="'$(Configuration)' != 'Release' or '$(MSBuildProjectName)' != 'UnifiedCalendar.App'">false</SelfContained>
  </PropertyGroup>
</Project>

