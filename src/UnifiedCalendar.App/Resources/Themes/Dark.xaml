<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:presentation="clr-namespace:UnifiedCalendar.App.Presentation">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFC8C8C8" />
    <SolidColorBrush x:Key="BorderBrush"
                     Color="#FFFFFFFF"
                     Opacity="{x:Static presentation:ColorMetrics.SeparatorOpacity}" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FF303030" />
    <SolidColorBrush x:Key="LinkBrush" Color="#FF60CDFF" />
    <SolidColorBrush x:Key="FocusBrush" Color="#FF60CDFF" />
    <SolidColorBrush x:Key="FocusForegroundBrush" Color="#FF181818" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#FFAAAAAA" />
    <SolidColorBrush x:Key="ScrollBarGlyphBrush" Color="#FFB0B0B0" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFFF99A4" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="HoverOverlayBrush"
                     Color="#FFFFFFFF"
                     Opacity="{x:Static presentation:ColorMetrics.HoverOpacity}" />
</ResourceDictionary>
