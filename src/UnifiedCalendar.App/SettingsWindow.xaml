                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="{Binding ToggleEnabledText}"
                                                      Command="{Binding DataContext.ToggleRuleCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                      CommandParameter="{Binding}"
                                                      Content="{Binding EnabledText}"
                                                      IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                      ToolTip="{Binding ToggleEnabledText}" />
