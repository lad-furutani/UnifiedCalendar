                                                    FontFamily="Segoe MDL2 Assets"
                                                    ToolTip="{Binding DataContext.MoveUpText, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                                            <Button Margin="{x:Static presentation:LayoutMetrics.SettingsInlineItemMargin}"
                                                    Padding="{x:Static presentation:LayoutMetrics.SettingsButtonPadding}"
                                                    AutomationProperties.Name="{Binding DataContext.MoveDownText, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    Command="{Binding DataContext.MoveRuleDownCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    CommandParameter="{Binding}"
                                                    Content="&#xE70D;"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    ToolTip="{Binding DataContext.MoveDownText, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                                            <Button Margin="{x:Static presentation:LayoutMetrics.SettingsInlineItemMargin}"
                                                    Padding="{x:Static presentation:LayoutMetrics.SettingsButtonPadding}"
                                                    AutomationProperties.Name="{Binding DataContext.EditText, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    Command="{Binding DataContext.EditRuleCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    CommandParameter="{Binding}"
                                                    Content="&#xE70F;"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    ToolTip="{Binding DataContext.EditText, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                                            <Button Padding="{x:Static presentation:LayoutMetrics.SettingsButtonPadding}"
