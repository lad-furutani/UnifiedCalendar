                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button HorizontalAlignment="Left"
                        Padding="{x:Static presentation:LayoutMetrics.SettingsButtonPadding}"
                        Command="{Binding BackCommand}"
                        Content="{Binding BackText}"
                        Visibility="{Binding IsPostRegistrationFlow, Converter={StaticResource BooleanVisibility}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsPlaceholderViewModel}">
            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="{Binding Text}"
                       TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:DisplaySettingsViewModel}">
            <StackPanel>
                <StackPanel Margin="{x:Static presentation:LayoutMetrics.SettingsFieldMargin}">
                    <TextBlock Margin="{x:Static presentation:LayoutMetrics.SettingsLabelMargin}"
                               Text="{Binding DaysText}" />
                    <controls:IntegerSpinner Width="{x:Static presentation:LayoutMetrics.SettingsSpinnerWidth}"
                                             HorizontalAlignment="Left"
                                             Minimum="{x:Static persistence:DisplayPreferences.MinimumDays}"
                                             Maximum="{x:Static persistence:DisplayPreferences.MaximumDays}"
                                             Value="{Binding Days, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="{x:Static presentation:LayoutMetrics.SettingsFieldMargin}">
                    <TextBlock Margin="{x:Static presentation:LayoutMetrics.SettingsLabelMargin}"
                               Text="{Binding FontSizeText}" />
                    <controls:IntegerSpinner Width="{x:Static presentation:LayoutMetrics.SettingsSpinnerWidth}"
                                             HorizontalAlignment="Left"
                                             Minimum="{x:Static persistence:DisplayPreferences.MinimumFontSizeDip}"
                                             Maximum="{x:Static persistence:DisplayPreferences.MaximumFontSizeDip}"
                                             Value="{Binding FontSizeDip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="{x:Static presentation:LayoutMetrics.SettingsFieldMargin}">
                    <TextBlock Margin="{x:Static presentation:LayoutMetrics.SettingsLabelMargin}"
                               Text="{Binding DensityText}" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Margin="{x:Static presentation:LayoutMetrics.SettingsInlineItemMargin}"
                                     IsChecked="{Binding IsCompact, Mode=TwoWay}"
                                     Content="{Binding CompactText}" />
                        <RadioButton Margin="{x:Static presentation:LayoutMetrics.SettingsInlineItemMargin}"
                                     IsChecked="{Binding IsStandard, Mode=TwoWay}"
                                     Content="{Binding StandardText}" />
                        <RadioButton IsChecked="{Binding IsComfortable, Mode=TwoWay}"
                                     Content="{Binding ComfortableText}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <TextBlock Margin="{x:Static presentation:LayoutMetrics.SettingsLabelMargin}"
                               Text="{Binding DefaultColorText}" />
                    <ListBox HorizontalAlignment="Left"
                             ItemsSource="{Binding ColorOptions}"
                             SelectedItem="{Binding SelectedColorOption, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.Template>
                            <ControlTemplate TargetType="{x:Type ListBox}">
                                <ItemsPresenter />
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}"
                                   BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Margin"
                                        Value="{x:Static presentation:LayoutMetrics.SettingsPaletteItemMargin}" />
                                <Setter Property="Padding"
                                        Value="{x:Static presentation:LayoutMetrics.SettingsPaletteSelectionPadding}" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="BorderThickness"
                                        Value="{x:Static presentation:LayoutMetrics.FocusBorder}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border Padding="{TemplateBinding Padding}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{x:Static presentation:LayoutMetrics.SettingsColorSwatchSize}"
                                        Height="{x:Static presentation:LayoutMetrics.SettingsColorSwatchSize}"
                                        AutomationProperties.Name="{Binding Name}"
                                        BorderThickness="{x:Static presentation:LayoutMetrics.SeparatorBorder}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        Background="{Binding Brush}"
                                        ToolTip="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Margin="{x:Static presentation:LayoutMetrics.SettingsLabelMargin}"
                                Orientation="Horizontal">
                        <Border Width="{x:Static presentation:LayoutMetrics.SettingsColorSwatchSize}"
                                Height="{x:Static presentation:LayoutMetrics.SettingsColorSwatchSize}"
                                Margin="{x:Static presentation:LayoutMetrics.SettingsInlineItemMargin}"
                                BorderThickness="{x:Static presentation:LayoutMetrics.SeparatorBorder}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Background="{Binding CurrentColorBrush}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding CurrentColorText}" />
                    </StackPanel>
                    <Button HorizontalAlignment="Left"
                            Padding="{x:Static presentation:LayoutMetrics.SettingsButtonPadding}"
                            Click="PickCustomColorClick"
                            Content="{Binding CustomColorText}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ColorRulesSettingsViewModel}">
            <Grid>
                <StackPanel x:Name="ColorRuleListPanel">
                    <TextBlock Margin="{x:Static presentation:LayoutMetrics.SettingsLabelMargin}"
                               FontWeight="SemiBold"
                               Text="{Binding HeadingText}" />
                    <TextBlock Margin="{x:Static presentation:LayoutMetrics.SettingsFieldMargin}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding EmptyText}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BooleanVisibility}}" />
                    <ItemsControl Margin="{x:Static presentation:LayoutMetrics.SettingsFieldMargin}"
                                  ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="{x:Static presentation:LayoutMetrics.SettingsLabelMargin}"
                                        Padding="{x:Static presentation:LayoutMetrics.SettingsSpinnerTextPadding}"
                                        AllowDrop="True"
                                        BorderThickness="{x:Static presentation:LayoutMetrics.SeparatorBorder}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        DragOver="ColorRuleRowDragOver"
                                        Drop="ColorRuleRowDrop"
                                        MouseMove="ColorRuleRowMouseMove"
                                        PreviewMouseLeftButtonDown="ColorRuleRowPreviewMouseLeftButtonDown">
