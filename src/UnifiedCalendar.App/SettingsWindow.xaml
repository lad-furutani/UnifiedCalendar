<Window x:Class="UnifiedCalendar.App.SettingsWindow"
        x:Name="SettingsRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:UnifiedCalendar.App.Controls"
        xmlns:persistence="clr-namespace:UnifiedCalendar.Core.Persistence;assembly=UnifiedCalendar.Core"
        xmlns:presentation="clr-namespace:UnifiedCalendar.App.Presentation"
        xmlns:viewModels="clr-namespace:UnifiedCalendar.App.ViewModels"
        Title="{Binding Title}"
        Icon="Resources/UnifiedCalendar.ico"
        Width="{x:Static presentation:LayoutMetrics.InitialSettingsWidth}"
        Height="{x:Static presentation:LayoutMetrics.InitialSettingsHeight}"
        MinWidth="{x:Static presentation:LayoutMetrics.MinimumSettingsWidth}"
        MinHeight="{x:Static presentation:LayoutMetrics.MinimumSettingsHeight}"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        ResizeMode="CanResize"
        FontFamily="Yu Gothic UI"
        FontSize="14"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        PreviewKeyDown="WindowPreviewKeyDown"
        LocationChanged="WindowLocationChanged"
        SizeChanged="WindowSizeChanged"
        StateChanged="WindowStateChanged">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
        <presentation:ValueVisibilityConverter x:Key="ValueVisibility" />
        <Style x:Key="SettingsControlForegroundStyle" TargetType="{x:Type Control}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style TargetType="{x:Type RepeatButton}"
               BasedOn="{StaticResource SettingsControlForegroundStyle}">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="{x:Static presentation:LayoutMetrics.SeparatorBorder}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource ApplicationButtonBaseTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type ToggleButton}"
               BasedOn="{StaticResource SettingsControlForegroundStyle}">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="{x:Static presentation:LayoutMetrics.SeparatorBorder}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource ApplicationButtonBaseTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type PasswordBox}"
               BasedOn="{StaticResource SettingsControlForegroundStyle}">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="{x:Static presentation:LayoutMetrics.SeparatorBorder}" />
            <Setter Property="Padding"
                    Value="{x:Static presentation:LayoutMetrics.SettingsSpinnerTextPadding}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource FocusBrush}" />
            <Setter Property="SelectionTextBrush" Value="{DynamicResource FocusForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border x:Name="StateBorder"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StateBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="StateBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="StateBorder"
                                        Property="Background"
                                        Value="{DynamicResource ButtonBackgroundBrush}" />
                                <Setter TargetName="StateBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource BorderBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource SecondaryTextBrush}" />
                                <Setter TargetName="PART_ContentHost"
                                        Property="TextElement.Foreground"
                                        Value="{DynamicResource SecondaryTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource SettingsControlForegroundStyle}">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="{x:Static presentation:LayoutMetrics.SeparatorBorder}" />
            <Setter Property="Padding"
                    Value="{x:Static presentation:LayoutMetrics.SettingsSpinnerTextPadding}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid x:Name="ComboBoxRoot"
                              MinWidth="{TemplateBinding MinWidth}"
                              MinHeight="{TemplateBinding MinHeight}">
                            <Border x:Name="SelectionBorder"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Background="{TemplateBinding Background}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{x:Static presentation:LayoutMetrics.SettingsSpinnerButtonGridWidth}" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="SelectionContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  IsHitTestVisible="False"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <Viewbox Grid.Column="1"
                                         Margin="{x:Static presentation:LayoutMetrics.SettingsSpinnerTextPadding}"
                                         IsHitTestVisible="False">
                                    <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="{TemplateBinding Foreground}" />
                                </Viewbox>
                            </Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=DropDownToggle}"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Width="{Binding ActualWidth, ElementName=ComboBoxRoot}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        Background="{DynamicResource PanelBackgroundBrush}">
                                    <ScrollViewer CanContentScroll="True"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="SelectionBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SelectionBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type ComboBoxItem}"
               BasedOn="{StaticResource SettingsControlForegroundStyle}">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="{x:Static presentation:LayoutMetrics.SeparatorBorder}" />
            <Setter Property="Padding"
                    Value="{x:Static presentation:LayoutMetrics.SettingsSpinnerTextPadding}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FocusBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource FocusForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FocusBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource FocusForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FocusBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource FocusForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FocusBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource FocusForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type ListBoxItem}"
               BasedOn="{StaticResource SettingsControlForegroundStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="{x:Static presentation:LayoutMetrics.SeparatorBorder}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FocusBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource FocusForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FocusBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource FocusForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FocusBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource FocusForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type CheckBox}"
               BasedOn="{StaticResource SettingsControlForegroundStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding"
                    Value="{x:Static presentation:LayoutMetrics.SettingsPaletteSelectionPadding}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="StateBorder"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="SelectionIndicator"
                                        Margin="{x:Static presentation:LayoutMetrics.SettingsPaletteSelectionPadding}"
                                        Padding="{x:Static presentation:LayoutMetrics.SettingsPaletteSelectionPadding}"
                                        BorderThickness="{x:Static presentation:LayoutMetrics.SeparatorBorder}"
                                        BorderBrush="{DynamicResource PrimaryTextBrush}"
                                        Background="{DynamicResource ButtonBackgroundBrush}">
                                    <Path x:Name="CheckMark"
                                          Data="M 0 3 L 3 6 L 8 0"
                                          Stroke="Transparent"
                                          StrokeThickness="{x:Static presentation:LayoutMetrics.FocusBorderThickness}" />
                                </Border>
                                <ContentPresenter x:Name="StateContent"
                                                  Grid.Column="1"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                  RecognizesAccessKey="True"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionIndicator"
                                        Property="Background"
                                        Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="CheckMark"
                                        Property="Stroke"
                                        Value="{DynamicResource FocusForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StateBorder"
                                        Property="Background"
                                        Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="SelectionIndicator"
                                        Property="BorderBrush"
                                        Value="{DynamicResource FocusForegroundBrush}" />
                                <Setter TargetName="StateContent"
                                        Property="TextElement.Foreground"
                                        Value="{DynamicResource FocusForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StateBorder"
                                        Property="Background"
                                        Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="SelectionIndicator"
                                        Property="BorderBrush"
                                        Value="{DynamicResource FocusForegroundBrush}" />
                                <Setter TargetName="StateContent"
                                        Property="TextElement.Foreground"
                                        Value="{DynamicResource FocusForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="StateBorder"
                                        Property="Background"
                                        Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="SelectionIndicator"
                                        Property="BorderBrush"
                                        Value="{DynamicResource FocusForegroundBrush}" />
                                <Setter TargetName="StateContent"
                                        Property="TextElement.Foreground"
                                        Value="{DynamicResource FocusForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="StateBorder"
                                        Property="Background"
                                        Value="Transparent" />
                                <Setter TargetName="SelectionIndicator"
                                        Property="BorderBrush"
                                        Value="{DynamicResource SecondaryTextBrush}" />
                                <Setter TargetName="SelectionIndicator"
                                        Property="Background"
                                        Value="{DynamicResource ButtonBackgroundBrush}" />
                                <Setter TargetName="StateContent"
                                        Property="TextElement.Foreground"
                                        Value="{DynamicResource SecondaryTextBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsEnabled" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CheckMark"
                                        Property="Stroke"
                                        Value="{DynamicResource SecondaryTextBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type RadioButton}"
               BasedOn="{StaticResource SettingsControlForegroundStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding"
                    Value="{x:Static presentation:LayoutMetrics.SettingsPaletteSelectionPadding}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="StateBorder"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Margin="{x:Static presentation:LayoutMetrics.SettingsPaletteSelectionPadding}">
                                    <Path x:Name="SelectionIndicator"
                                          Data="M 5 0 A 5 5 0 1 1 4.999 0 Z"
                                          Fill="Transparent"
                                          Stroke="{DynamicResource PrimaryTextBrush}"
                                          StrokeThickness="{x:Static presentation:LayoutMetrics.FocusBorderThickness}" />
                                    <Path x:Name="SelectionMark"
                                          Data="M 5 2.5 A 2.5 2.5 0 1 1 4.999 2.5 Z"
                                          Fill="Transparent" />
                                </Grid>
                                <ContentPresenter x:Name="StateContent"
                                                  Grid.Column="1"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                  RecognizesAccessKey="True"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionIndicator"
                                        Property="Stroke"
                                        Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="SelectionMark"
                                        Property="Fill"
                                        Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StateBorder"
                                        Property="Background"
                                        Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="SelectionIndicator"
                                        Property="Stroke"
                                        Value="{DynamicResource FocusForegroundBrush}" />
                                <Setter TargetName="SelectionMark"
                                        Property="Fill"
                                        Value="{DynamicResource FocusForegroundBrush}" />
                                <Setter TargetName="StateContent"
                                        Property="TextElement.Foreground"
                                        Value="{DynamicResource FocusForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StateBorder"
                                        Property="Background"
                                        Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="SelectionIndicator"
                                        Property="Stroke"
                                        Value="{DynamicResource FocusForegroundBrush}" />
                                <Setter TargetName="SelectionMark"
                                        Property="Fill"
                                        Value="{DynamicResource FocusForegroundBrush}" />
                                <Setter TargetName="StateContent"
                                        Property="TextElement.Foreground"
                                        Value="{DynamicResource FocusForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="StateBorder"
                                        Property="Background"
                                        Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="SelectionIndicator"
                                        Property="Stroke"
                                        Value="{DynamicResource FocusForegroundBrush}" />
                                <Setter TargetName="SelectionMark"
                                        Property="Fill"
                                        Value="{DynamicResource FocusForegroundBrush}" />
                                <Setter TargetName="StateContent"
                                        Property="TextElement.Foreground"
                                        Value="{DynamicResource FocusForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="StateBorder"
                                        Property="Background"
                                        Value="Transparent" />
                                <Setter TargetName="SelectionIndicator"
                                        Property="Stroke"
                                        Value="{DynamicResource SecondaryTextBrush}" />
                                <Setter TargetName="StateContent"
                                        Property="TextElement.Foreground"
                                        Value="{DynamicResource SecondaryTextBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsEnabled" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SelectionMark"
                                        Property="Fill"
                                        Value="{DynamicResource SecondaryTextBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type GroupBox}"
               BasedOn="{StaticResource SettingsControlForegroundStyle}" />
        <DataTemplate DataType="{x:Type viewModels:AccountSettingsViewModel}">
            <StackPanel>
                <TextBlock Margin="{x:Static presentation:LayoutMetrics.SettingsLabelMargin}"
                           FontWeight="SemiBold"
                           Text="{Binding HeadingText}" />
                <StackPanel Margin="{x:Static presentation:LayoutMetrics.SettingsFieldMargin}"
                            Orientation="Horizontal">
                    <Button Margin="{x:Static presentation:LayoutMetrics.SettingsInlineItemMargin}"
                            Padding="{x:Static presentation:LayoutMetrics.SettingsButtonPadding}"
                            Command="{Binding AddGoogleAccountCommand}"
                            Content="{Binding AddGoogleText}"
                            ToolTip="{Binding GoogleUnavailableToolTip}"
                            ToolTipService.ShowOnDisabled="True" />
                    <Button Padding="{x:Static presentation:LayoutMetrics.SettingsButtonPadding}"
                            Command="{Binding AddMicrosoftAccountCommand}"
                            Content="{Binding AddMicrosoftText}"
                            ToolTip="{Binding MicrosoftUnavailableToolTip}"
                            ToolTipService.ShowOnDisabled="True" />
                </StackPanel>
                <TextBlock Margin="{x:Static presentation:LayoutMetrics.SettingsFieldMargin}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{Binding AuthenticationProgressText}"
                           Visibility="{Binding AuthenticationProgressText, Converter={StaticResource ValueVisibility}}" />
                <TextBlock Margin="{x:Static presentation:LayoutMetrics.SettingsFieldMargin}"
                           Foreground="{DynamicResource ErrorBrush}"
                           Text="{Binding OperationMessage}"
                           TextWrapping="Wrap"
                           Visibility="{Binding OperationMessage, Converter={StaticResource ValueVisibility}}" />
                <TextBlock Margin="{x:Static presentation:LayoutMetrics.SettingsFieldMargin}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{Binding EmptyText}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BooleanVisibility}}" />
                <ItemsControl ItemsSource="{Binding Accounts}"
                              KeyboardNavigation.TabNavigation="Continue"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:AccountListItemViewModel}">
                            <Border Margin="{x:Static presentation:LayoutMetrics.SettingsLabelMargin}"
                                    Padding="{x:Static presentation:LayoutMetrics.SettingsSpinnerTextPadding}"
                                    BorderThickness="{x:Static presentation:LayoutMetrics.SeparatorBorder}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource ButtonBackgroundBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding DisplayIdentity}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   ToolTip="{Binding DisplayIdentity}" />
                                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Text="{Binding Email}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   ToolTip="{Binding Email}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Margin="{x:Static presentation:LayoutMetrics.SettingsInfoValueMargin}"
                                               FontWeight="SemiBold"
                                               Text="{Binding ProviderText}" />
                                    <StackPanel Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Margin="{x:Static presentation:LayoutMetrics.SettingsLabelMargin}"
                                                Orientation="Horizontal">
