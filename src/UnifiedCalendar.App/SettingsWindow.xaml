                                                                  ToolTipService.ShowOnDisabled="True" />
                                                        <StackPanel Grid.Row="1"
                                                                    Grid.Column="1"
                                                                    Grid.ColumnSpan="2">
                                                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                                                       Text="{Binding ReadUnavailableText}"
                                                                       TextWrapping="Wrap"
                                                                       Visibility="{Binding ShowReadUnavailableReason, Converter={StaticResource BooleanVisibility}}" />
                                                            <TextBlock Foreground="{DynamicResource ErrorBrush}"
                                                                       Text="{Binding SyncWarningText}"
                                                                       ToolTip="{Binding SyncWarningToolTip}"
                                                                       Visibility="{Binding HasSyncWarning, Converter={StaticResource BooleanVisibility}}" />
                                                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                                                       Text="{Binding BusyText}"
                                                                       Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
