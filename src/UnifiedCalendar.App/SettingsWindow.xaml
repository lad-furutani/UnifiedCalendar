                            Command="{Binding AddRuleCommand}"
                            ToolTip="{Binding AddText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="{x:Static presentation:LayoutMetrics.SettingsInlineItemMargin}"
                                       FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE710;" />
                            <TextBlock Text="{Binding AddText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

