                                 ItemsSource="{Binding ColorOptions}"
                                 SelectedItem="{Binding SelectedColorOption, Mode=TwoWay}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.Template>
                                <ControlTemplate TargetType="{x:Type ListBox}">
                                    <ItemsPresenter />
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}"
                                       BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Margin"
                                            Value="{x:Static presentation:LayoutMetrics.SettingsPaletteItemMargin}" />
                                    <Setter Property="Padding"
                                            Value="{x:Static presentation:LayoutMetrics.SettingsPaletteSelectionPadding}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="BorderThickness"
                                            Value="{x:Static presentation:LayoutMetrics.FocusBorder}" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                <Border Padding="{TemplateBinding Padding}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{x:Static presentation:LayoutMetrics.SettingsColorSwatchSize}"
                                            Height="{x:Static presentation:LayoutMetrics.SettingsColorSwatchSize}"
                                            AutomationProperties.Name="{Binding Name}"
                                            BorderThickness="{x:Static presentation:LayoutMetrics.SeparatorBorder}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            Background="{Binding Brush}"
                                            ToolTip="{Binding Name}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Margin="{x:Static presentation:LayoutMetrics.SettingsLabelMargin}"
                                    Orientation="Horizontal">
                            <Border Width="{x:Static presentation:LayoutMetrics.SettingsColorSwatchSize}"
                                    Height="{x:Static presentation:LayoutMetrics.SettingsColorSwatchSize}"
                                    Margin="{x:Static presentation:LayoutMetrics.SettingsInlineItemMargin}"
                                    BorderThickness="{x:Static presentation:LayoutMetrics.SeparatorBorder}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{Binding CurrentColorBrush}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding CurrentColorText}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Left"
                                Padding="{x:Static presentation:LayoutMetrics.SettingsButtonPadding}"
                                Click="PickRuleCustomColorClick"
                                Content="{Binding CustomColorText}" />
                    </StackPanel>

                    <StackPanel Margin="{x:Static presentation:LayoutMetrics.SettingsFieldMargin}">
                        <TextBlock Margin="{x:Static presentation:LayoutMetrics.SettingsLabelMargin}"
                                   FontWeight="SemiBold"
                                   Text="{Binding PreviewText}" />
                        <Border BorderThickness="{x:Static presentation:LayoutMetrics.BottomSeparatorBorder}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Background="{Binding Preview.Background}">
                            <Grid Margin="{x:Static presentation:LayoutMetrics.SettingsSpinnerTextPadding}"
                                  TextElement.Foreground="{Binding Preview.Foreground}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="{x:Static presentation:LayoutMetrics.SettingsInlineItemMargin}"
                                           VerticalAlignment="Center"
                                           Text="{Binding Preview.ListTime}" />
                                <TextBlock Grid.Column="1"
                                           Margin="{x:Static presentation:LayoutMetrics.SettingsInlineItemMargin}"
                                           VerticalAlignment="Center"
                                           Text="{Binding Preview.Title}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{Binding Preview.ProviderMark}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Margin="{x:Static presentation:LayoutMetrics.SettingsInlineItemMargin}"
                                Padding="{x:Static presentation:LayoutMetrics.SettingsButtonPadding}"
                                Command="{Binding SaveCommand}"
                                Content="{Binding SaveText}" />
                        <Button Padding="{x:Static presentation:LayoutMetrics.SettingsButtonPadding}"
                                Command="{Binding CancelEditCommand}"
                                Content="{Binding CancelText}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="ColorRuleListPanel" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ColorRuleEditorPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:UpdateSettingsViewModel}">
            <StackPanel>
                <TextBlock Margin="{x:Static presentation:LayoutMetrics.SettingsLabelMargin}"
                           Text="{Binding IntervalText}" />
                <ComboBox Width="{x:Static presentation:LayoutMetrics.SettingsSpinnerWidth}"
                          HorizontalAlignment="Left"
                          ItemsSource="{Binding IntervalOptions}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedInterval, Mode=TwoWay}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:GeneralSettingsViewModel}">
            <StackPanel>
                <CheckBox Margin="{x:Static presentation:LayoutMetrics.SettingsSectionMargin}"
                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                          Content="{Binding StartWithWindowsText}" />
                <StackPanel Margin="{x:Static presentation:LayoutMetrics.SettingsSectionMargin}">
                    <TextBlock Margin="{x:Static presentation:LayoutMetrics.SettingsLabelMargin}"
                               FontWeight="SemiBold"
                               Text="{Binding ApplicationInfoHeadingText}" />
                    <TextBlock Margin="{x:Static presentation:LayoutMetrics.SettingsInfoValueMargin}"
                               Text="{Binding ApplicationNameText}" />
                    <TextBlock Margin="{x:Static presentation:LayoutMetrics.SettingsInfoValueMargin}"
                               Text="{Binding VersionText}" />
                    <TextBlock Margin="{x:Static presentation:LayoutMetrics.SettingsInfoValueMargin}"
                               Text="{Binding BuildTimeText}" />
                </StackPanel>
                <StackPanel Margin="{x:Static presentation:LayoutMetrics.SettingsSectionMargin}">
                    <TextBlock Margin="{x:Static presentation:LayoutMetrics.SettingsLabelMargin}"
                               FontWeight="SemiBold"
                               Text="{Binding LocalFilesHeadingText}" />
                    <Button Margin="{x:Static presentation:LayoutMetrics.SettingsFieldMargin}"
                            HorizontalAlignment="Left"
                            Padding="{x:Static presentation:LayoutMetrics.SettingsButtonPadding}"
                            Command="{Binding OpenRootDirectoryCommand}"
                            Content="{Binding OpenRootDirectoryText}" />
                    <Button Margin="{x:Static presentation:LayoutMetrics.SettingsFieldMargin}"
                            HorizontalAlignment="Left"
                            Padding="{x:Static presentation:LayoutMetrics.SettingsButtonPadding}"
                            Command="{Binding OpenSettingsFileCommand}"
                            Content="{Binding OpenSettingsFileText}" />
                    <Button Margin="{x:Static presentation:LayoutMetrics.SettingsFieldMargin}"
                            HorizontalAlignment="Left"
                            Padding="{x:Static presentation:LayoutMetrics.SettingsButtonPadding}"
                            Command="{Binding OpenLogsDirectoryCommand}"
                            Content="{Binding OpenLogsDirectoryText}" />
                    <Button HorizontalAlignment="Left"
                            Padding="{x:Static presentation:LayoutMetrics.SettingsButtonPadding}"
                            Command="{Binding OpenLatestLogFileCommand}"
                            Content="{Binding OpenLatestLogFileText}" />
                </StackPanel>
                <Separator Margin="{x:Static presentation:LayoutMetrics.SettingsSectionMargin}"
                           Background="{DynamicResource BorderBrush}" />
                <Button HorizontalAlignment="Left"
                        Padding="{x:Static presentation:LayoutMetrics.SettingsButtonPadding}"
                        Command="{Binding ResetToDefaultsCommand}"
                        Content="{Binding ResetToDefaultsText}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="CategoryList"
                     Grid.Column="0"
                     Margin="12"
                     Padding="0"
                     ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory}"
                     DisplayMemberPath="Title"
                     BorderBrush="{DynamicResource BorderBrush}"
                     Background="{DynamicResource PanelBackgroundBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     KeyboardNavigation.TabIndex="0"
                     KeyboardNavigation.TabNavigation="Once" />

            <Border Grid.Column="1"
                    Margin="0,12,12,12"
                    Padding="20"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource PanelBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Text="{Binding SelectedCategory.Title}" />
                    <ScrollViewer x:Name="CategoryScrollViewer"
                                  Grid.Row="1"
                                  Margin="0,18,0,0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ContentControl x:Name="CategoryContent"
                                        Focusable="True"
                                        KeyboardNavigation.IsTabStop="True"
                                        KeyboardNavigation.TabIndex="1"
                                        Content="{Binding SelectedCategory.Content}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Padding="12"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource PanelBackgroundBrush}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="OkButton"
                        MinWidth="88"
                        Padding="12,6"
                        KeyboardNavigation.TabIndex="2"
                        Command="{Binding OkCommand}"
                        Content="{Binding OkText}" />
                <Button x:Name="ApplyButton"
                        MinWidth="88"
                        Margin="8,0,0,0"
                        Padding="12,6"
                        KeyboardNavigation.TabIndex="3"
                        Command="{Binding ApplyCommand}"
                        Content="{Binding ApplyText}" />
                <Button x:Name="CancelButton"
                        MinWidth="88"
                        Margin="8,0,0,0"
                        Padding="12,6"
                        KeyboardNavigation.TabIndex="4"
                        Command="{Binding CancelCommand}"
                        Content="{Binding CancelText}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
