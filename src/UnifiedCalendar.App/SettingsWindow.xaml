                                                        Margin="{x:Static presentation:LayoutMetrics.SettingsInlineItemMargin}">
                                                <TextBlock VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           ToolTip="{Binding Name}" />
                                                <TextBlock VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Text="{Binding ConditionSummary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           ToolTip="{Binding ConditionSummary}" />
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    Width="{x:Static presentation:LayoutMetrics.SettingsColorSwatchSize}"
                                                    Height="{x:Static presentation:LayoutMetrics.SettingsColorSwatchSize}"
